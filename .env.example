# Google AI Studio Gemini API key
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Lightweight multilingual embedding model that runs locally
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_PATH=data/models

QDRANT_PATH=data/qdrant
UPLOAD_PATH=data/uploads
COLLECTION_NAME=pdf_rag_documents

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
MINIMUM_SCORE=0.20

MAX_UPLOAD_MB=50
MAX_FILES_PER_UPLOAD=10
LOG_LEVEL=INFO

# OCR for scanned PDFs (runs locally through Tesseract)
OCR_ENABLED=true
OCR_LANGUAGE=tur+eng
OCR_DPI=220
OCR_MIN_CHARS=30
# Optional: set this only when Tesseract cannot auto-detect the tessdata folder.
OCR_TESSDATA_PATH=
